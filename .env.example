# PracticeMap — required environment variables.
# Copy this file to .env and fill in the values there. .env is gitignored.
# Never put a real key in this file; it is committed.

# Anthropic API key used by the application's server-side recognition and
# advice calls. Read explicitly by src/server/recognition/claude_adapter.py —
# the app never falls back to ANTHROPIC_API_KEY or any other credential
# source, so example mode genuinely runs without credentials.
PRACTICEMAP_ANTHROPIC_API_KEY=

# Optional. Anthropic model ID. Defaults to claude-opus-5 in code if unset.
PRACTICEMAP_MODEL=
